rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Legacy, hardcoded-year collections (kept during migration) ---
    match /scholarshipApplications/{document} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    match /scholarshipApplications-2025/{document} {
      allow read: if request.auth != null;
      allow write: if true;
    }
    match /offline/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /offline-2025/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /_cache/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /refund-2025/{document} {
      allow read: if true;
      allow write: if true;
    }

    // --- New year-scoped schema: scholarships/{year}/... ---
    match /scholarships/{year} {
      allow read: if true;
      allow write: if request.auth != null;

      match /applications/{document} {
        allow read: if request.auth != null;
        allow write: if true;
      }
      match /offline/{document} {
        allow read: if true;
        allow write: if true;
      }
      match /refunds/{document} {
        allow read: if true;
        allow write: if true;
      }
      match /cache/{document} {
        allow read: if true;
        allow write: if true;
      }
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
